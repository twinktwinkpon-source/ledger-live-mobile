{
  "name": "ledger-live-desktop",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cross-env NODE_ENV=development FLEX_DEMO=true TS_NODE_PROJECT=tools/rspack/tsconfig.json node --require ts-node/register ./tools/main-rspack.ts",
        "cwd": "apps/ledger-live-desktop"
      }
    },
    "start:msw": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cross-env NODE_ENV=development ENABLE_MSW=true TS_NODE_PROJECT=tools/rspack/tsconfig.json node --require ts-node/register ./tools/main-rspack.ts",
        "cwd": "apps/ledger-live-desktop"
      }
    },
    "build": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "desktopEnv",
        "sharedEnv"
      ]
    },
    "build:testing": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "build-lib-deps": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "test": {
      "dependsOn": [
        "build:testing"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    }
  }
}
