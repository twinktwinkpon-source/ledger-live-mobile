diff --git a/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm b/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm
@@ -438,7 +438,22 @@
     @try {
       [inv invokeWithTarget:strongModule];
     } @catch (NSException *exception) {
-      throw convertNSExceptionToJSError(runtime, exception, std::string{moduleName}, methodNameStr);
+      // FLEX safety patch (v2): converting the NSException to a JSError here
+      // touches the jsi::Runtime from THIS background thread while the JS
+      // thread may be executing inside Hermes concurrently -> heap corruption
+      // SIGSEGV. But rethrowing natively abort()s the whole app when any void
+      // TurboModule throws (observed on the turbomodule queue right after a
+      // scan with the flex server unreachable). The correct escape: log the
+      // exception with full details and swallow it — an async void method has
+      // no JS-facing return path, so there is nothing to propagate to anyway.
+      RCTLogError(
+          @"TurboModule %s.%s raised %@ (%@)\n%@\n--- original call stack ---\n%@",
+          moduleName,
+          methodNameStr.c_str(),
+          exception.name,
+          exception.reason,
+          exception.callStackSymbols,
+          NSThread.callStackSymbols);
     } @finally {
       [retainedObjectsForInvocation removeAllObjects];
     }
